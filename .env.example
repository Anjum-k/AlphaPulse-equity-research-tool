# OpenAI API Key (Required for embeddings and GPT response generation)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Custom Base URL (if using Azure OpenAI, LocalLLM, OpenRouter or proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default Vector DB: 'FAISS' or 'ChromaDB'
DEFAULT_VECTOR_DB=FAISS

# Default Model: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
DEFAULT_LLM_MODEL=gpt-4o-mini

